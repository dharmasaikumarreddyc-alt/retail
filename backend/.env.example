ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
DATABASE_URL=sqlite+aiosqlite:///./aisle.db
CORS_ORIGINS=["http://localhost:3000"]

# Set only when you explicitly seed the demo merchant account.
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=

# Configure at least one AI provider:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Azure OpenAI requires all three:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
